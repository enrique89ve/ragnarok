# Ragnarok mainnet profile
#
# Mainnet is the permanent economic environment. Build the browser bundle with
# this profile only after the genesis/mainnet launch checklist is approved.

VITE_NETWORK_STAGE=mainnet

VITE_RAGNAROK_PROTOCOL_ID=ragnarok-cards
VITE_RAGNAROK_COLLECTION_ID=ragnarok-alpha
VITE_RAGNAROK_RESET_EPOCH=mainnet-genesis
VITE_SEASON_START=2026-06-14T23:28:54Z
VITE_RAGNAROK_INDEX_START_BLOCK=107278144

# Public account names only. These are bundled into the browser and must not be
# private keys.
# Admin signs panel login with Posting and prepared admin transactions with
# Active. Operator co-signs those admin transactions from the server.
VITE_RAGNAROK_ADMIN_ACCOUNT=ragnarok
VITE_RAGNAROK_ADMIN_OPERATOR_ACCOUNT=ragnarok-operator
VITE_RAGNAROK_GENESIS_ACCOUNT=ragnarok-genesis
VITE_RAGNAROK_TREASURY_ACCOUNT=ragnarok-treasury
VITE_RAGNAROK_INDEX_ACCOUNT=ragnarok-index

# Fill these when the shared services are deployed.
VITE_RAGNAROK_INDEXER_URL=
VITE_RAGNAROK_ART_INDEXER_URL=

VITE_NFTLOX_PROTOCOL_ID=nftlox
VITE_NFT_ART_BASE_URL=https://dhenz14.github.io/norse-mythos-card-game
VITE_EXTERNAL_URL_BASE=https://dhenz14.github.io/norse-mythos-card-game

# Server indexer. Disable this in decentralized/operator-first production if a
# separate indexer service owns replay projection.
ENABLE_CHAIN_INDEXER=true
RAGNAROK_CHAIN_STATE_FILE=data/chain-state.mainnet.json
# Server-side mirror of VITE_SEASON_START so split deployments use the same
# season boundary as browser/admin diagnostics.
RAGNAROK_SEASON_START=2026-06-14T23:28:54Z
# Server-side mirror of VITE_RAGNAROK_INDEX_START_BLOCK so fresh indexer state
# never replays all historical Hive.
RAGNAROK_INDEX_START_BLOCK=107278144
RAGNAROK_RANGE_SCAN=true
RAGNAROK_HAF_ENDPOINTS=https://api.hive.blog

# Optional on-chain checkpoint publisher. This writes compact projection hashes
# to Hive with RAGNAROK_INDEX_ACCOUNT posting authority.
ENABLE_INDEX_CHECKPOINT_PUBLISHER=false
RAGNAROK_INDEX_CHECKPOINT_INTERVAL_BLOCKS=100
# Set true only when testing the publisher path without broadcasting a Hive tx.
RAGNAROK_INDEX_CHECKPOINT_DRY_RUN=false

# Optional server/operator-only overrides for split deployments. These are not
# exposed to the browser. If unset, server code falls back to the matching
# VITE_* account/protocol value above.
# RAGNAROK_PROTOCOL_ID=ragnarok-cards
# RAGNAROK_RESET_EPOCH=mainnet-genesis
# RAGNAROK_SEASON_START=2026-06-14T23:28:54Z
# RAGNAROK_ADMIN_OPERATOR_ACCOUNT=ragnarok-operator

# Hive private keys. Never add VITE_ to these names.
#
# Required only when testing private admin operations. Prefer a dedicated
# operator process for mainnet active keys.
# RAGNAROK_ADMIN_OPERATOR_ACTIVE_KEY=<WIF active key for ragnarok-operator>

# Required only when the index checkpoint publisher is enabled.
# RAGNAROK_INDEX_ACCOUNT=ragnarok-index
# RAGNAROK_INDEX_POSTING_KEY=<WIF posting key for ragnarok-index>

# Required only for the future match-pending witness signer.
# WITNESS_HIVE_ACCOUNT=ragnarok-witness
# WITNESS_HIVE_POSTING_KEY=<WIF posting key for ragnarok-witness>
