# ========================================
# AI AGENT / IDE TOOL DIRECTORIES
# ========================================
# Each AI-coding tool drops its own state/config directory.
# These should never be committed — they're per-developer environment.
.agents/
.codex/
.gstack/
.scratch/*
# Exception: protocol workstream scratch dirs are tracked because their PRD +
# DECISIONS + issue files are referenced from committed ADRs and act as the
# canonical Phase planning artefact (see docs/adr/0004-...md §Decision.5).
# Using `.scratch/*` (not `.scratch/`) so explicit re-includes below work —
# git cannot re-include a child of a fully-excluded parent directory.
!.scratch/game-protocol-v2-phase1/
.codebuddy/
.commandcode/
.continue/
.crush/
.factory/
.goose/
.junie/
.kilocode/
.kiro/
.kode/
.mcpjam/
.mux/
.neovate/
.openhands/
.pi/
.pochi/
.qoder/
.qwen/
.roo/
.trae/
.windsurf/
.zencoder/

# Project-local skill installations (skills should be global, not per-project)
skills/
skills-lock.json

# ========================================
# STALE COMPILED FILES - BUILD ARTIFACTS
# ========================================
# Prevent stale .js files from accumulating in source directories
# These can cause Vite module resolution issues

client/src/**/*.js
!client/src/vite-env.d.ts

# ========================================
# DOCUMENTATION GUIDELINES
# ========================================
# When pushing to GitHub:
# 1. NEVER include database URLs or connection strings
# 2. NEVER include API keys or secrets
# 3. NEVER include Replit internal configuration
# 4. NEVER include one-off test/fix scripts
# 5. Always verify with: git status --ignored

# Asset packs (build artifacts, ~255MB zips)
client/public/packs/

# Unused art stockpile (kept locally, not deployed)
client/public/art/unused/

# Internal map editor (local-only authoring tool). The viewer ships publicly;
# only the editor-specific files stay local. The map image is publicly served.
# Pattern-based so any future MapAtlas* authoring file stays local too.
client/src/game/components/map/MapAtlas*.tsx
client/src/game/components/map/editor/

# Local combat layout prototypes. Approved layout data belongs in
# client/src/game/combat/layout/, not in throwaway prototype routes.
client/src/game/combat/prototypes/

