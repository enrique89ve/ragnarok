# Ragnarok Alfa Testnet profile
#
# Alfa Testnet is a one-week, production-hosted testnet alias for Dokploy.
# It keeps the canonical network stage as testnet; do not set
# VITE_NETWORK_STAGE=practice or VITE_NETWORK_STAGE=alfa-testnet.

RAGNAROK_RUNTIME_MODE=alfa-testnet
VITE_NETWORK_STAGE=testnet

# Dokploy Dockerfile defaults. Override only after a compatibility pass.
NODE_VERSION=20.20.2
NODE_ALPINE_VERSION=3.22

VITE_RAGNAROK_PROTOCOL_ID=rk_game_testnet
VITE_RAGNAROK_COLLECTION_ID=ragnarok-testnet
VITE_RAGNAROK_RESET_EPOCH=alfa-testnet-full-nft-2026-05-22
VITE_SEASON_START=2026-06-14T23:28:54Z
VITE_RAGNAROK_INDEX_START_BLOCK=107278144

# Public account names only. These values are bundled into the browser build.
VITE_RAGNAROK_ADMIN_ACCOUNT=ragnarok-test
VITE_RAGNAROK_ADMIN_OPERATOR_ACCOUNT=ragnarok-test-operator
VITE_RAGNAROK_GENESIS_ACCOUNT=ragnarok-test
VITE_RAGNAROK_TREASURY_ACCOUNT=ragp2p
VITE_RAGNAROK_INDEX_ACCOUNT=ragp2p

VITE_RAGNAROK_INDEXER_URL=
VITE_RAGNAROK_ART_INDEXER_URL=
# NFTLoX is not an Alfa requirement. Leave empty until the Closed Beta
# collection proof exists.
# VITE_NFTLOX_PROTOCOL_ID=nftlox_testnet
VITE_NFT_ART_BASE_URL=https://dhenz14.github.io/norse-mythos-card-game
VITE_EXTERNAL_URL_BASE=https://dhenz14.github.io/norse-mythos-card-game

# Server JSON state. In Dokploy this path resolves under the mounted /app/data
# volume when the default Docker working directory is /app.
ENABLE_CHAIN_INDEXER=true
RAGNAROK_CHAIN_STATE_FILE=data/chain-state.alfa-testnet.json
RAGNAROK_NFT_OWNERSHIP_SOURCE=json
# Server-side mirror of VITE_SEASON_START for split deployments.
RAGNAROK_SEASON_START=2026-06-14T23:28:54Z
# Server-side mirror of VITE_RAGNAROK_INDEX_START_BLOCK for fresh state files.
RAGNAROK_INDEX_START_BLOCK=107278144
RAGNAROK_RANGE_SCAN=true
RAGNAROK_HAF_ENDPOINTS=https://api.hive.blog

# Required in Dokploy/shared environments so P2P direct challenge envelopes
# survive redeploys and any future multi-replica routing. Generate a 64-char
# value with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# P2P_CHALLENGE_SIGNING_SECRET=<64-hex-chars>

# Optional on-chain checkpoint publisher. Keep disabled unless explicitly
# testing checkpoint writes.
ENABLE_INDEX_CHECKPOINT_PUBLISHER=false
RAGNAROK_INDEX_CHECKPOINT_INTERVAL_BLOCKS=100
RAGNAROK_INDEX_CHECKPOINT_DRY_RUN=true

# Optional server/operator-only overrides for split deployments. These are not
# exposed to the browser. If unset, server code falls back to the matching
# public VITE_* account/protocol value above.
# RAGNAROK_PROTOCOL_ID=rk_game_testnet
# RAGNAROK_RESET_EPOCH=alfa-testnet-full-nft-2026-05-22
# RAGNAROK_SEASON_START=2026-06-14T23:28:54Z
# RAGNAROK_ADMIN_OPERATOR_ACCOUNT=ragnarok-test-operator

# Hive private keys. Never add VITE_ to these names.
# Required in shared Alfa so the Admin Panel can prepare/broadcast private
# admin operations through the server-side operator co-sign path.
# RAGNAROK_ADMIN_OPERATOR_ACTIVE_KEY=<WIF active key for ragnarok-test-operator>
# RAGNAROK_INDEX_ACCOUNT=ragp2p
# RAGNAROK_INDEX_POSTING_KEY=<WIF posting key for ragp2p>
# WITNESS_HIVE_ACCOUNT=ragnarok-witness
# WITNESS_HIVE_POSTING_KEY=<WIF posting key for ragnarok-witness>

# Closed Beta invite evidence. Leave empty during Alfa. Set only after the
# matching proof exists; these values are read by /api/admin/config.
# RAGNAROK_NFTLOX_COLLECTION_PROOF=
# RAGNAROK_HIVE_KEYCHAIN_SMOKE=
# RAGNAROK_P2P_TWO_BROWSER_SMOKE=
# RAGNAROK_CLOSED_BETA_OPERATOR_SIGNOFF=
