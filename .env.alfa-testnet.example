# Paste this file into Dokploy → Environment.
# Fill P2P_CHALLENGE_SIGNING_SECRET. Leave the fingerprint block unchanged:
# those values must match the image (Vite bakes them at build; the tab cannot
# rebuild the browser). Blank keys fall back to the same baked defaults.
# Do not add VITE_DATA_LAYER_MODE, VITE_BLOCKCHAIN_PACKAGING, or NFTLox.
# WebRTC remains disabled until the real two-browser canary is complete.
# Runtime transport policy is public, validated, and can change without a
# browser rebuild. WebRTC remains disabled until the real two-browser canary.
P2P_WEBRTC_ENABLED=false
P2P_WS_FALLBACK_ENABLED=true
P2P_WEBRTC_NORMAL_MS=8000
P2P_WEBRTC_AGGRESSIVE_MS=5000
P2P_RELAY_CONNECT_MS=8000
P2P_ICE_SERVERS=stun:testnetdev.ragnaroknft.quest:3478

# --- secrets (UI) ---
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
P2P_CHALLENGE_SIGNING_SECRET=

# RAGNAROK_ADMIN_OPERATOR_ACTIVE_KEY=
# P2P_RELAY_ALLOWED_ORIGINS=https://<your-public-game-host>
# RAGNAROK_INDEX_POSTING_KEY=
# WITNESS_HIVE_ACCOUNT=
# WITNESS_HIVE_POSTING_KEY=

# --- fingerprint (safe to paste; keep equal pairs) ---
VITE_NETWORK_STAGE=testnet
VITE_RAGNAROK_PROTOCOL_ID=rk_game_testnet
VITE_RAGNAROK_COLLECTION_ID=ragnarok-testnet
VITE_RAGNAROK_RESET_EPOCH=alfa-testnet-full-nft-2026-05-22
VITE_SEASON_START=2026-06-14T23:28:54Z
VITE_RAGNAROK_INDEX_START_BLOCK=109016418
RAGNAROK_PROTOCOL_ID=rk_game_testnet
RAGNAROK_RESET_EPOCH=alfa-testnet-full-nft-2026-05-22
RAGNAROK_SEASON_START=2026-06-14T23:28:54Z
RAGNAROK_INDEX_START_BLOCK=109016418
RAGNAROK_CHAIN_STATE_FILE=data/chain-state.alfa-testnet.json
RAGNAROK_NFT_OWNERSHIP_SOURCE=json
