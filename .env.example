# Database Configuration (PostgreSQL / Neon)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
PGHOST=your-db-host.neon.tech
PGPORT=5432
PGUSER=your_db_user
PGPASSWORD=your_db_password
PGDATABASE=your_db_name

# Session Secret (generate a random string)
SESSION_SECRET=your-session-secret-here

# Ragnarok runtime environment
# Full shared-network examples live in .env.testnet.example and
# .env.mainnet.example. Keep plain local development on this default.
# VITE_NETWORK_STAGE is the normal source of truth:
# - local: private development, local data, resettable, no economic value
# - testnet: shared beta network, Hive data, resettable, no permanent value
# - mainnet: production economy, Hive data, permanent ownership
VITE_NETWORK_STAGE=local

# Optional advanced overrides for focused tests/debugging only.
# Normal local/testnet/mainnet runs should not set these.
# VITE_DATA_LAYER_MODE=test
# VITE_BLOCKCHAIN_PACKAGING=false

# Optional per-network overrides. Defaults are defined in shared/runtimeConfig.ts.
# VITE_RAGNAROK_PROTOCOL_ID is the normal shared source for browser + server namespace.
# VITE_RAGNAROK_PROTOCOL_ID=rk_game_testnet
# VITE_RAGNAROK_COLLECTION_ID=ragnarok-testnet
# Frontend admin account required for Admin Panel login/approval.
# VITE_RAGNAROK_ADMIN_ACCOUNT=ragnarok-test
# Public operator account that broadcasts approved admin ops. Must be different
# from VITE_RAGNAROK_ADMIN_ACCOUNT when admin multisig is enabled.
# VITE_RAGNAROK_ADMIN_OPERATOR_ACCOUNT=ragnarok-test-operator
# VITE_RAGNAROK_GENESIS_ACCOUNT=ragnarok-test
# VITE_RAGNAROK_TREASURY_ACCOUNT=ragnarok-test
# VITE_RAGNAROK_INDEX_ACCOUNT=ragnarok-test-index
# VITE_RAGNAROK_INDEXER_URL=https://testnet-indexer.example.com
# VITE_RAGNAROK_ART_INDEXER_URL=https://testnet-art.example.com
# VITE_NFTLOX_PROTOCOL_ID=nftlox_testnet
# VITE_NFT_ART_BASE_URL=https://dhenz14.github.io/norse-mythos-card-game
# VITE_EXTERNAL_URL_BASE=https://dhenz14.github.io/norse-mythos-card-game

# Optional server/operator-only override for split deployments.
# If unset, server code should fall back to VITE_RAGNAROK_PROTOCOL_ID.
# RAGNAROK_PROTOCOL_ID=rk_game_testnet
# If unset, server code falls back to VITE_RAGNAROK_ADMIN_OPERATOR_ACCOUNT.
# RAGNAROK_ADMIN_OPERATOR_ACCOUNT=ragnarok-test-operator

# Hive private keys are server/operator-only. Never prefix them with VITE_;
# Vite exposes VITE_* variables to browser code. See docs/ENV_SECURITY.md.
# HIVE_POSTING_KEY=your-operator-posting-key
# HIVE_ACTIVE_KEY=your-dedicated-operator-active-key-only-if-needed
# RAGNAROK_ADMIN_OPERATOR_ACTIVE_KEY=your-dedicated-admin-operator-active-key

# Sensitive server/operator-only values:
# - DATABASE_URL, PGPASSWORD, SESSION_SECRET
# - HIVE_POSTING_KEY / HIVE_ACTIVE_KEY / any Hive WIF or PVT_* private key
# - RAGNAROK_ADMIN_OPERATOR_ACTIVE_KEY
# - ANTHROPIC_API_KEY
# - CLOUDINARY_API_SECRET
# Keep CLOUDINARY_API_KEY server-only too unless a browser upload flow explicitly needs it.

# Claude Code API (optional - for scripts/automation)
# ANTHROPIC_API_KEY=sk-ant-...

# Cloudinary (optional - for card art hosting)
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# Multiplayer (optional - PeerJS uses free public server by default)
# To self-host a PeerJS signaling server, set these:
# PEER_SERVER_HOST=your-peer-server.com
# PEER_SERVER_PORT=9000
# PEER_SERVER_PATH=/myapp

# Match pending queue witness signer (ADR 0004 §Decision.3, DECISIONS.md §D4).
# When an opponent goes offline mid-match, the winner posts the final
# envelope to /api/chain/match/pending and the server witness-signs the
# arrival timestamp using this Hive Posting key. Clients verify against
# the on-chain Posting authority of WITNESS_HIVE_ACCOUNT. Required for
# the server to start when match/pending routes are mounted; validated at
# boot via RPC round-trip to confirm pubkey matches the account.
# WITNESS_HIVE_ACCOUNT=ragnarok-witness
# WITNESS_HIVE_POSTING_KEY=<WIF Posting private key>
