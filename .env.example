# Database Configuration (PostgreSQL / Neon)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
PGHOST=your-db-host.neon.tech
PGPORT=5432
PGUSER=your_db_user
PGPASSWORD=your_db_password
PGDATABASE=your_db_name

# Session Secret (generate a random string)
SESSION_SECRET=your-session-secret-here

# Local workshop (`pnpm run dev`). Guest Single, no Keychain.
# To rehearse the launched Alfa: `pnpm run dev:alfa-testnet` (do not paste
# that fingerprint here). Generic/QA testnet: `.env.testnet.example`.
# Dokploy secrets: `.env.alfa-testnet.example`. Mainnet: `.env.mainnet.example`.
#
# VITE_NETWORK_STAGE is the only switch in this file:
# local | testnet | mainnet. Epoch/protocol/collection live in the profile
# examples. Do not set VITE_DATA_LAYER_MODE, VITE_BLOCKCHAIN_PACKAGING, or
# VITE_NFTLOX_PROTOCOL_ID here — see docs/NFT_DEV_TESTING.md.
VITE_NETWORK_STAGE=local

# Hive private keys are server/operator-only. Never prefix them with VITE_;
# Vite exposes VITE_* variables to browser code. See docs/ENV_SECURITY.md.
# HIVE_POSTING_KEY=your-operator-posting-key
# HIVE_ACTIVE_KEY=your-dedicated-operator-active-key-only-if-needed
# RAGNAROK_ADMIN_OPERATOR_ACTIVE_KEY=your-dedicated-admin-operator-active-key
# RAGNAROK_INDEX_ACCOUNT=ragp2p
# RAGNAROK_INDEX_POSTING_KEY=your-index-account-posting-key

# P2P relay security. Server-only: never prefix these with VITE_.
# Stable shared secret used for server-signed P2P challenges and relay match
# tickets. Required in production/shared deployments.
# P2P_CHALLENGE_SIGNING_SECRET=<64-hex-chars>
# Comma-separated browser origins allowed to open /ws/p2p when Origin does not
# match Host, e.g. split frontend/API domains.
# P2P_RELAY_ALLOWED_ORIGINS=https://game.example.com
# Trust X-Forwarded-Host for Origin checks only when the app is strictly behind
# a trusted reverse proxy that overwrites the header.
# P2P_RELAY_TRUST_FORWARDED_HOST=false
# Express proxy trust stays disabled by default. Behind a known proxy set only
# one of these (never `true` and never both); hops is usually safer than a
# broad CIDR when the Dokploy topology is fixed.
# RAGNAROK_TRUST_PROXY_HOPS=1
# RAGNAROK_TRUST_PROXY_CIDRS=
# Runtime transport policy is public and can be changed without rebuilding the
# browser. These server-only P2P_* values are the active source of truth.
# P2P_WEBRTC_ENABLED=false
# P2P_WS_FALLBACK_ENABLED=true
# P2P_WEBRTC_NORMAL_MS=8000
# P2P_WEBRTC_AGGRESSIVE_MS=5000
# P2P_RELAY_CONNECT_MS=8000
# P2P_ICE_SERVERS=stun:stun.example.test:3478
# Do not put TURN credentials, tickets, SDP, or ICE credentials in this config.

# Sensitive server/operator-only values:
# - DATABASE_URL, PGPASSWORD, SESSION_SECRET
# - HIVE_POSTING_KEY / HIVE_ACTIVE_KEY / any Hive WIF or PVT_* private key
# - RAGNAROK_ADMIN_OPERATOR_ACTIVE_KEY
# - P2P_CHALLENGE_SIGNING_SECRET
# - ANTHROPIC_API_KEY
# - CLOUDINARY_API_SECRET
# Keep CLOUDINARY_API_KEY server-only too unless a browser upload flow explicitly needs it.

# Claude Code API (optional - for scripts/automation)
# ANTHROPIC_API_KEY=sk-ant-...

# Cloudinary (optional - for card art hosting)
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# Multiplayer uses the server-mediated /ws/p2p relay. Legacy PeerJS variables
# are no longer part of the active P2P path.

# Match pending queue witness signer (ADR 0004 §Decision.3, DECISIONS.md §D4).
# When an opponent goes offline mid-match, the winner posts the final
# envelope to /api/chain/match/pending and the server witness-signs the
# arrival timestamp using this Hive Posting key. Clients verify against
# the on-chain Posting authority of WITNESS_HIVE_ACCOUNT. Required for
# the server to start when match/pending routes are mounted; validated at
# boot via RPC round-trip to confirm pubkey matches the account.
# WITNESS_HIVE_ACCOUNT=ragnarok-witness
# WITNESS_HIVE_POSTING_KEY=<WIF Posting private key>
