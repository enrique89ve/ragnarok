# Database Configuration (PostgreSQL / Neon)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
PGHOST=your-db-host.neon.tech
PGPORT=5432
PGUSER=your_db_user
PGPASSWORD=your_db_password
PGDATABASE=your_db_name

# Session Secret (generate a random string)
SESSION_SECRET=your-session-secret-here

# Ragnarok runtime environment
# Full shared-network examples live in .env.testnet.example,
# .env.alfa-testnet.example, and .env.mainnet.example. Keep plain local
# development on this default.
# VITE_NETWORK_STAGE is the normal source of truth:
# - local: private development, local data, resettable, no economic value
# - testnet: shared beta network, Hive data, resettable, no permanent value
# - mainnet: production economy, Hive data, permanent ownership
VITE_NETWORK_STAGE=local

# Optional advanced overrides for focused tests/debugging only.
# Normal local/testnet/mainnet runs should not set these.
# VITE_DATA_LAYER_MODE=test
# VITE_BLOCKCHAIN_PACKAGING=false

# Optional per-network overrides. Defaults are defined in shared/runtimeConfig.ts.
# VITE_RAGNAROK_PROTOCOL_ID is the normal shared source for browser + server namespace.
# VITE_RAGNAROK_PROTOCOL_ID=rk_game_testnet
# VITE_RAGNAROK_COLLECTION_ID=ragnarok-testnet
# Reset epoch isolates browser/server projections for a resettable phase.
# Change this when starting QA Season 0, Closed Testnet Beta, or any wipe.
# VITE_RAGNAROK_RESET_EPOCH=qa-s0-2026-05
# Public phase boundary evidence. Mirror the server start block when exposing
# the phase in browser/admin diagnostics.
# VITE_SEASON_START=2026-06-14T23:28:54Z
# VITE_RAGNAROK_INDEX_START_BLOCK=107278144
# Frontend admin account required for Admin Panel login and transaction signing.
# VITE_RAGNAROK_ADMIN_ACCOUNT=ragnarok-test
# Public operator account that co-signs prepared admin ops from the server.
# Must be different from VITE_RAGNAROK_ADMIN_ACCOUNT when admin operator
# broadcasting is enabled.
# VITE_RAGNAROK_ADMIN_OPERATOR_ACCOUNT=ragnarok-test-operator
# VITE_RAGNAROK_GENESIS_ACCOUNT=ragnarok-test
# Treasury only receives payments; it should not grant protocol authority.
# VITE_RAGNAROK_TREASURY_ACCOUNT=ragp2p
# Public account clients read index/checkpoint pointers from.
# VITE_RAGNAROK_INDEX_ACCOUNT=ragp2p
# VITE_RAGNAROK_INDEXER_URL=https://testnet-indexer.example.com
# VITE_RAGNAROK_ART_INDEXER_URL=https://testnet-art.example.com
# VITE_NFTLOX_PROTOCOL_ID=nftlox_testnet
# VITE_NFT_ART_BASE_URL=https://dhenz14.github.io/norse-mythos-card-game
# VITE_EXTERNAL_URL_BASE=https://dhenz14.github.io/norse-mythos-card-game

# Optional server/operator-only override for split deployments.
# If unset, server code should fall back to VITE_RAGNAROK_PROTOCOL_ID.
# RAGNAROK_PROTOCOL_ID=rk_game_testnet
# Optional server-only mirror of VITE_RAGNAROK_RESET_EPOCH for split deployments.
# RAGNAROK_RESET_EPOCH=qa-s0-2026-05
# Optional server-only mirror of VITE_SEASON_START for split deployments.
# RAGNAROK_SEASON_START=2026-06-14T23:28:54Z
# If unset, server code falls back to VITE_RAGNAROK_ADMIN_OPERATOR_ACCOUNT.
# RAGNAROK_ADMIN_OPERATOR_ACCOUNT=ragnarok-test-operator
# Explicit server indexer state file for shared-network profiles.
# ENABLE_CHAIN_INDEXER=true
# RAGNAROK_CHAIN_STATE_FILE=data/chain-state.testnet.json
# RAGNAROK_NFT_OWNERSHIP_SOURCE=json
# Optional fresh-state bootstrap cursor. Defaults to the runtime
# indexStartBlock; set this to the first block where this profile's Ragnarok
# protocol can appear when the server boundary differs from browser evidence.
# RAGNAROK_INDEX_START_BLOCK=107278144
# Optional fast catch-up controls. Range scan is enabled by default and uses
# HafAH to skip large block gaps quickly; set false only while debugging RPC.
# RAGNAROK_RANGE_SCAN=true
# RAGNAROK_HAF_ENDPOINTS=https://api.hive.blog
# Optional on-chain projection checkpoint publisher.
# ENABLE_INDEX_CHECKPOINT_PUBLISHER=false
# RAGNAROK_INDEX_CHECKPOINT_INTERVAL_BLOCKS=100
# RAGNAROK_INDEX_CHECKPOINT_DRY_RUN=true

# Hive private keys are server/operator-only. Never prefix them with VITE_;
# Vite exposes VITE_* variables to browser code. See docs/ENV_SECURITY.md.
# HIVE_POSTING_KEY=your-operator-posting-key
# HIVE_ACTIVE_KEY=your-dedicated-operator-active-key-only-if-needed
# RAGNAROK_ADMIN_OPERATOR_ACTIVE_KEY=your-dedicated-admin-operator-active-key
# RAGNAROK_INDEX_ACCOUNT=ragp2p
# RAGNAROK_INDEX_POSTING_KEY=your-index-account-posting-key

# P2P relay security. Server-only: never prefix these with VITE_.
# Stable shared secret used for server-signed P2P challenges and relay match
# tickets. Required in production/shared deployments.
# P2P_CHALLENGE_SIGNING_SECRET=<64-hex-chars>
# Comma-separated browser origins allowed to open /ws/p2p when Origin does not
# match Host, e.g. split frontend/API domains.
# P2P_RELAY_ALLOWED_ORIGINS=https://game.example.com
# Trust X-Forwarded-Host for Origin checks only when the app is strictly behind
# a trusted reverse proxy that overwrites the header.
# P2P_RELAY_TRUST_FORWARDED_HOST=false

# Sensitive server/operator-only values:
# - DATABASE_URL, PGPASSWORD, SESSION_SECRET
# - HIVE_POSTING_KEY / HIVE_ACTIVE_KEY / any Hive WIF or PVT_* private key
# - RAGNAROK_ADMIN_OPERATOR_ACTIVE_KEY
# - P2P_CHALLENGE_SIGNING_SECRET
# - ANTHROPIC_API_KEY
# - CLOUDINARY_API_SECRET
# Keep CLOUDINARY_API_KEY server-only too unless a browser upload flow explicitly needs it.

# Claude Code API (optional - for scripts/automation)
# ANTHROPIC_API_KEY=sk-ant-...

# Cloudinary (optional - for card art hosting)
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# Multiplayer uses the server-mediated /ws/p2p relay. Legacy PeerJS variables
# are no longer part of the active P2P path.

# Match pending queue witness signer (ADR 0004 §Decision.3, DECISIONS.md §D4).
# When an opponent goes offline mid-match, the winner posts the final
# envelope to /api/chain/match/pending and the server witness-signs the
# arrival timestamp using this Hive Posting key. Clients verify against
# the on-chain Posting authority of WITNESS_HIVE_ACCOUNT. Required for
# the server to start when match/pending routes are mounted; validated at
# boot via RPC round-trip to confirm pubkey matches the account.
# WITNESS_HIVE_ACCOUNT=ragnarok-witness
# WITNESS_HIVE_POSTING_KEY=<WIF Posting private key>
