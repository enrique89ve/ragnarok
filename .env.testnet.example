# Ragnarok beta-testnet profile
#
# Testnet should behave like mainnet for gameplay, replay, P2P, NFT and reward
# validation, but all state is resettable and has no permanent economic value.

VITE_NETWORK_STAGE=testnet

# This file is generic/QA testnet, not the Alfa launch replica.
# Alfa on localhost: `pnpm run dev:alfa-testnet` (epoch alfa-testnet-*).
# Rotating the epoch is a wipe. Keep the VITE_* and RAGNAROK_* pair equal.

VITE_RAGNAROK_PROTOCOL_ID=rk_game_testnet
VITE_RAGNAROK_COLLECTION_ID=ragnarok-testnet
VITE_RAGNAROK_RESET_EPOCH=testnet-s01-2026-05-19
VITE_SEASON_START=2026-06-14T23:28:54Z
VITE_RAGNAROK_INDEX_START_BLOCK=109016418
RAGNAROK_PROTOCOL_ID=rk_game_testnet
RAGNAROK_RESET_EPOCH=testnet-s01-2026-05-19
RAGNAROK_SEASON_START=2026-06-14T23:28:54Z
RAGNAROK_INDEX_START_BLOCK=109016418

# Public account names only. These are bundled into the browser and must not be
# private keys.
#
# Admin: the only Hive account allowed to request Admin Panel access with
# Keychain Posting and sign prepared admin transactions with Active.
VITE_RAGNAROK_ADMIN_ACCOUNT=ragnarok-test

# Operator: public server/operator account. The server co-signs prepared admin
# transactions with this account, but private keys stay server-only below.
VITE_RAGNAROK_ADMIN_OPERATOR_ACCOUNT=ragnarok-test-operator

# Legacy/manual genesis ceremony account. Leave as the admin account unless a
# separate ceremony account is still being tested.
VITE_RAGNAROK_GENESIS_ACCOUNT=ragnarok-test

# Treasury only receives HBD/HIVE payments. It does not grant admin, operator,
# indexer, or protocol authority.
VITE_RAGNAROK_TREASURY_ACCOUNT=ragp2p

# Public index/checkpoint account. Clients read index checkpoints from here.
# The server posting key for writing checkpoints is server-only below.
VITE_RAGNAROK_INDEX_ACCOUNT=ragp2p

# Fill these when the shared services are deployed.
VITE_RAGNAROK_INDEXER_URL=
VITE_RAGNAROK_ART_INDEXER_URL=

# Leave NFTLoX unset in F1/F2. Do not set VITE_DATA_LAYER_MODE or
# VITE_BLOCKCHAIN_PACKAGING; they derive from VITE_NETWORK_STAGE.
VITE_NFT_ART_BASE_URL=https://dhenz14.github.io/norse-mythos-card-game
VITE_EXTERNAL_URL_BASE=https://dhenz14.github.io/norse-mythos-card-game

# Server indexer. Reading/replaying Hive blocks does not require any Hive key.
#
# NOTE: Express starts the chain indexer by default unless
# ENABLE_CHAIN_INDEXER=false. Keep this explicit in testnet so the intended
# profile is obvious.
ENABLE_CHAIN_INDEXER=true
RAGNAROK_CHAIN_STATE_FILE=data/chain-state.testnet.json
RAGNAROK_RANGE_SCAN=true
RAGNAROK_HAF_ENDPOINTS=https://api.hive.blog

# Optional on-chain checkpoint publisher. This writes compact projection hashes
# to Hive with RAGNAROK_INDEX_ACCOUNT posting authority.
ENABLE_INDEX_CHECKPOINT_PUBLISHER=false
RAGNAROK_INDEX_CHECKPOINT_INTERVAL_BLOCKS=100
# Set true only when testing the publisher path without broadcasting a Hive tx.
RAGNAROK_INDEX_CHECKPOINT_DRY_RUN=true

# Split-deploy account override only. Fingerprint mirrors are set above.
# RAGNAROK_ADMIN_OPERATOR_ACCOUNT=ragnarok-test-operator

# Hive private keys. Never add VITE_ to these names.
#
# Required only when testing private admin operations. This key must be the
# Active private key for VITE_RAGNAROK_ADMIN_OPERATOR_ACCOUNT /
# RAGNAROK_ADMIN_OPERATOR_ACCOUNT.
# RAGNAROK_ADMIN_OPERATOR_ACTIVE_KEY=<WIF active key for ragnarok-test-operator>

# Required only when the index checkpoint publisher is enabled. This should be
# the Posting private key for VITE_RAGNAROK_INDEX_ACCOUNT / RAGNAROK_INDEX_ACCOUNT.
# RAGNAROK_INDEX_ACCOUNT=ragp2p
# RAGNAROK_INDEX_POSTING_KEY=<WIF posting key for ragp2p>

# Required only for the future match-pending witness signer.
# WITNESS_HIVE_ACCOUNT=ragnarok-witness
# WITNESS_HIVE_POSTING_KEY=<WIF posting key for ragnarok-witness>
