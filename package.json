{
	"name": "norse-mythos-card-game",
	"version": "1.2.0",
	"description": "Ragnarok: Norse Mythos Card Game — 2,400+ cards, 80 heroes, poker combat, Hive NFT blockchain",
	"type": "module",
	"license": "MIT",
	"engines": {
		"node": ">=24 <25",
		"npm": ">=10 <12",
		"pnpm": ">=11"
	},
	"packageManager": "pnpm@11.22.0",
	"scripts": {
		"dev": "CHOKIDAR_USEPOLLING=1 tsx server/index.ts",
		"dev:local": "pnpm run dev",
		"dev:testnet": "CHOKIDAR_USEPOLLING=1 tsx server/index.ts --mode testnet",
		"dev:alfa-testnet": "CHOKIDAR_USEPOLLING=1 VITE_NETWORK_STAGE=${VITE_NETWORK_STAGE:-testnet} VITE_RAGNAROK_PROTOCOL_ID=${VITE_RAGNAROK_PROTOCOL_ID:-rk_game_testnet} VITE_RAGNAROK_COLLECTION_ID=${VITE_RAGNAROK_COLLECTION_ID:-ragnarok-testnet} VITE_RAGNAROK_RESET_EPOCH=${VITE_RAGNAROK_RESET_EPOCH:-alfa-testnet-full-nft-2026-05-22} VITE_SEASON_START=${VITE_SEASON_START:-2026-06-14T23:28:54Z} VITE_RAGNAROK_INDEX_START_BLOCK=${VITE_RAGNAROK_INDEX_START_BLOCK:-109016418} ENABLE_CHAIN_INDEXER=${ENABLE_CHAIN_INDEXER:-true} RAGNAROK_CHAIN_STATE_FILE=${RAGNAROK_CHAIN_STATE_FILE:-data/chain-state.alfa-testnet.json} RAGNAROK_NFT_OWNERSHIP_SOURCE=${RAGNAROK_NFT_OWNERSHIP_SOURCE:-json} RAGNAROK_PROTOCOL_ID=${RAGNAROK_PROTOCOL_ID:-${VITE_RAGNAROK_PROTOCOL_ID:-rk_game_testnet}} RAGNAROK_RESET_EPOCH=${RAGNAROK_RESET_EPOCH:-${VITE_RAGNAROK_RESET_EPOCH:-alfa-testnet-full-nft-2026-05-22}} RAGNAROK_SEASON_START=${RAGNAROK_SEASON_START:-${VITE_SEASON_START:-2026-06-14T23:28:54Z}} RAGNAROK_INDEX_START_BLOCK=${RAGNAROK_INDEX_START_BLOCK:-109016418} tsx server/index.ts --mode alfa-testnet",
		"dev:mainnet": "CHOKIDAR_USEPOLLING=1 tsx server/index.ts --mode mainnet",
		"dev:game": "pnpm run dev",
		"build:server": "esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist && esbuild server/services/indexer.worker.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/indexer.worker.js",
		"build": "vite build && pnpm run build:server",
		"build:testnet": "vite build --mode testnet && pnpm run build:server",
		"build:alfa-testnet": "pnpm run build:wasm && VITE_NETWORK_STAGE=${VITE_NETWORK_STAGE:-testnet} VITE_RAGNAROK_PROTOCOL_ID=${VITE_RAGNAROK_PROTOCOL_ID:-rk_game_testnet} VITE_RAGNAROK_COLLECTION_ID=${VITE_RAGNAROK_COLLECTION_ID:-ragnarok-testnet} VITE_RAGNAROK_RESET_EPOCH=${VITE_RAGNAROK_RESET_EPOCH:-alfa-testnet-full-nft-2026-05-22} VITE_SEASON_START=${VITE_SEASON_START:-2026-06-14T23:28:54Z} VITE_RAGNAROK_INDEX_START_BLOCK=${VITE_RAGNAROK_INDEX_START_BLOCK:-109016418} vite build --mode alfa-testnet && pnpm run build:server",
		"build:mainnet": "vite build --mode mainnet && pnpm run build:server",
		"build:static": "vite build",
		"verify:runtime-env": "node scripts/verifyRuntimeEnv.mjs",
		"prepare:chain-state-migration": "tsx scripts/prepareChainStateMigration.ts",
		"verify:alfa-runtime-env": "node scripts/verifyRuntimeEnv.mjs --mode alfa-testnet --scope runtime",
		"start": "NODE_ENV=production node dist/index.js",
		"start:testnet": "NODE_ENV=production node dist/index.js --mode testnet",
		"start:alfa-testnet": "NODE_ENV=production VITE_NETWORK_STAGE=${VITE_NETWORK_STAGE:-testnet} VITE_RAGNAROK_PROTOCOL_ID=${VITE_RAGNAROK_PROTOCOL_ID:-rk_game_testnet} VITE_RAGNAROK_COLLECTION_ID=${VITE_RAGNAROK_COLLECTION_ID:-ragnarok-testnet} VITE_RAGNAROK_RESET_EPOCH=${VITE_RAGNAROK_RESET_EPOCH:-alfa-testnet-full-nft-2026-05-22} VITE_SEASON_START=${VITE_SEASON_START:-2026-06-14T23:28:54Z} VITE_RAGNAROK_INDEX_START_BLOCK=${VITE_RAGNAROK_INDEX_START_BLOCK:-109016418} ENABLE_CHAIN_INDEXER=${ENABLE_CHAIN_INDEXER:-true} RAGNAROK_CHAIN_STATE_FILE=${RAGNAROK_CHAIN_STATE_FILE:-data/chain-state.alfa-testnet.json} RAGNAROK_NFT_OWNERSHIP_SOURCE=${RAGNAROK_NFT_OWNERSHIP_SOURCE:-json} RAGNAROK_PROTOCOL_ID=${RAGNAROK_PROTOCOL_ID:-${VITE_RAGNAROK_PROTOCOL_ID:-rk_game_testnet}} RAGNAROK_RESET_EPOCH=${RAGNAROK_RESET_EPOCH:-${VITE_RAGNAROK_RESET_EPOCH:-alfa-testnet-full-nft-2026-05-22}} RAGNAROK_SEASON_START=${RAGNAROK_SEASON_START:-${VITE_SEASON_START:-2026-06-14T23:28:54Z}} RAGNAROK_INDEX_START_BLOCK=${RAGNAROK_INDEX_START_BLOCK:-109016418} node dist/index.js --mode alfa-testnet",
		"start:mainnet": "NODE_ENV=production node dist/index.js --mode mainnet",
		"check": "tsc",
		"build:card-frames": "tsx scripts/exportCardFrames.ts",
		"audit:card-description-budget": "node scripts/auditCardDescriptionBudget.mjs",
		"test": "vitest run",
		"test:watch": "vitest",
		"smoke:phase0": "vitest run client/src/game/protocol/phase0.smoke.test.ts",
		"audit:determinism": "node scripts/audit-wasm-determinism.mjs",
		"qa:p2p-chaos": "node scripts/p2p-chaos-harness.mjs",
		"lint": "node scripts/run-eslint.mjs",
		"lint:fix": "node scripts/run-eslint.mjs --fix",
		"lint:css": "stylelint 'client/src/**/*.css' --max-warnings=0",
		"lint:css:dupes": "node scripts/check-css-cross-file-dupes.mjs",
		"lint:css:dupes:baseline": "node scripts/check-css-cross-file-dupes.mjs --baseline",
		"lint:css:dupes:infile": "node scripts/check-css-infile-dupes.mjs",
		"lint:css:dupes:infile:baseline": "node scripts/check-css-infile-dupes.mjs --baseline",
		"bench:claim-store": "tsx scripts/benchClaimStore.ts",
		"prototype:db-boundary": "tsx server/services/prototypes/dbAdapterBoundary/prototype.ts",
		"prototype:p2p-settlement": "tsx client/src/game/match/modes/p2p/prototypes/rankedSettlement/prototype.ts",
		"db:push": "drizzle-kit push",
		"db:setup": "tsx server/setupDatabase.ts",
		"db:seed": "tsx server/seedCardSupply.ts",
		"db:seed-packs": "tsx server/seedPackTypes.ts",
		"gen:collections": "tsx scripts/genCollections.ts",
		"audit:art": "tsx scripts/auditArt.ts",
		"build:wasm": "asc assembly/index.ts -o client/public/engine.wasm -t client/public/engine.wat --optimize --noAssert --runtime stub --exportRuntime --bindings esm",
		"build:wasm:debug": "asc assembly/index.ts -o client/public/engine.wasm -t client/public/engine.wat --debug --runtime stub --exportRuntime --bindings esm",
		"triage:art": "tsx scripts/triagePendingArt.ts"
	},
	"dependencies": {
		"@noble/curves": "^2.0.1",
		"@noble/hashes": "^2.0.1",
		"@tanstack/react-virtual": "^3.13.19",
		"@types/howler": "^2.2.12",
		"@typescript-eslint/eslint-plugin": "^8.31.0",
		"@typescript-eslint/parser": "^8.31.0",
		"clsx": "^2.1.1",
		"dotenv": "^16.4.7",
		"drizzle-orm": "^0.45.2",
		"drizzle-zod": "^0.7.1",
		"eslint": "^9.39.0",
		"eslint-plugin-react": "^7.37.5",
		"express": "^4.22.2",
		"express-rate-limit": "^8.2.1",
		"fflate": "^0.8.2",
		"framer-motion": "^11.13.1",
		"glob": "^11.0.1",
		"gsap": "^3.14.2",
		"helmet": "^8.1.0",
		"hive-tx": "^7.0.1",
		"howler": "^2.2.4",
		"lucide-react": "^0.453.0",
		"nanoid": "^5.1.6",
		"pg": "^8.15.6",
		"pixi.js": "^8.19.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-router-dom": "^6.30.4",
		"sonner": "^1.7.1",
		"stun": "2.1.0",
		"tailwind-merge": "^2.5.4",
		"ts-morph": "^25.0.1",
		"uuid": "^11.1.1",
		"ws": "^8.18.1",
		"zod": "^3.23.8",
		"zustand": "^5.0.3"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.0",
		"@resvg/resvg-js": "^2.6.2",
		"@tailwindcss/vite": "^4.2.4",
		"@types/express": "4.17.21",
		"@types/node": "^24.0.0",
		"@types/pg": "^8.11.6",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@types/ws": "^8.5.13",
		"@vitejs/plugin-react": "^6.0.5",
		"assemblyscript": "^0.28.9",
		"autoprefixer": "^10.4.20",
		"drizzle-kit": "^0.31.10",
		"esbuild": "^0.28.2",
		"eslint-plugin-react-hooks": "^5.1.0",
		"fake-indexeddb": "^6.2.5",
		"globals": "^16.5.0",
		"postcss": "^8.4.47",
		"rollup-plugin-visualizer": "^7.0.1",
		"sharp": "^0.35.3",
		"stylelint": "^17.6.0",
		"tailwindcss": "^4.2.4",
		"tsx": "^4.19.1",
		"typescript": "5.6.3",
		"vite": "^8.2.1",
		"vitest": "4.0.18"
	},
	"optionalDependencies": {
		"bufferutil": "^4.0.8"
	}
}
