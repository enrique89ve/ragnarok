{
	"name": "norse-mythos-card-game",
	"version": "1.2.0",
	"description": "Ragnarok: Norse Mythos Card Game — 2,400+ cards, 80 heroes, poker combat, Hive NFT blockchain",
	"type": "module",
	"license": "MIT",
	"scripts": {
		"dev": "CHOKIDAR_USEPOLLING=1 tsx server/index.ts",
		"dev:local": "npm run dev",
		"dev:testnet": "CHOKIDAR_USEPOLLING=1 tsx server/index.ts --mode testnet",
		"dev:mainnet": "CHOKIDAR_USEPOLLING=1 tsx server/index.ts --mode mainnet",
		"dev:game": "npm run dev",
		"build:server": "esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist && esbuild server/services/indexer.worker.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/indexer.worker.js",
		"build": "vite build && npm run build:server",
		"build:testnet": "vite build --mode testnet && npm run build:server",
		"build:alfa-testnet": "npm run build:wasm && VITE_NETWORK_STAGE=${VITE_NETWORK_STAGE:-testnet} VITE_RAGNAROK_PROTOCOL_ID=${VITE_RAGNAROK_PROTOCOL_ID:-rk_game_testnet} VITE_RAGNAROK_COLLECTION_ID=${VITE_RAGNAROK_COLLECTION_ID:-ragnarok-testnet} VITE_RAGNAROK_RESET_EPOCH=${VITE_RAGNAROK_RESET_EPOCH:-alfa-testnet-full-nft-2026-05-22} vite build --mode alfa-testnet && npm run build:server",
		"build:mainnet": "vite build --mode mainnet && npm run build:server",
		"build:static": "vite build",
		"verify:runtime-env": "node scripts/verifyRuntimeEnv.mjs",
		"start": "NODE_ENV=production node dist/index.js",
		"start:testnet": "NODE_ENV=production node dist/index.js --mode testnet",
		"start:alfa-testnet": "NODE_ENV=production VITE_NETWORK_STAGE=${VITE_NETWORK_STAGE:-testnet} VITE_RAGNAROK_PROTOCOL_ID=${VITE_RAGNAROK_PROTOCOL_ID:-rk_game_testnet} VITE_RAGNAROK_COLLECTION_ID=${VITE_RAGNAROK_COLLECTION_ID:-ragnarok-testnet} VITE_RAGNAROK_RESET_EPOCH=${VITE_RAGNAROK_RESET_EPOCH:-alfa-testnet-full-nft-2026-05-22} ENABLE_CHAIN_INDEXER=${ENABLE_CHAIN_INDEXER:-true} RAGNAROK_CHAIN_STATE_FILE=${RAGNAROK_CHAIN_STATE_FILE:-data/chain-state.alfa-testnet.json} RAGNAROK_NFT_OWNERSHIP_SOURCE=${RAGNAROK_NFT_OWNERSHIP_SOURCE:-json} node dist/index.js --mode alfa-testnet",
		"start:mainnet": "NODE_ENV=production node dist/index.js --mode mainnet",
		"check": "tsc",
		"test": "vitest run",
		"test:watch": "vitest",
		"smoke:phase0": "vitest run client/src/game/protocol/phase0.smoke.test.ts",
		"audit:determinism": "node scripts/audit-wasm-determinism.mjs",
		"lint": "node scripts/run-eslint.mjs",
		"lint:fix": "node scripts/run-eslint.mjs --fix",
		"lint:css": "stylelint 'client/src/**/*.css' --max-warnings=0",
		"lint:css:dupes": "node scripts/check-css-cross-file-dupes.mjs",
		"lint:css:dupes:baseline": "node scripts/check-css-cross-file-dupes.mjs --baseline",
		"lint:css:dupes:infile": "node scripts/check-css-infile-dupes.mjs",
		"lint:css:dupes:infile:baseline": "node scripts/check-css-infile-dupes.mjs --baseline",
		"bench:claim-store": "tsx scripts/benchClaimStore.ts",
		"prototype:db-boundary": "tsx server/services/prototypes/dbAdapterBoundary/prototype.ts",
		"prototype:p2p-settlement": "tsx client/src/game/match/modes/p2p/prototypes/rankedSettlement/prototype.ts",
		"db:push": "drizzle-kit push",
		"db:setup": "tsx server/setupDatabase.ts",
		"db:seed": "tsx server/seedCardSupply.ts",
		"db:seed-packs": "tsx server/seedPackTypes.ts",
		"gen:collections": "tsx scripts/genCollections.ts",
		"audit:art": "tsx scripts/auditArt.ts",
		"build:wasm": "asc assembly/index.ts -o client/public/engine.wasm -t client/public/engine.wat --optimize --noAssert --runtime stub --exportRuntime --bindings esm",
		"build:wasm:debug": "asc assembly/index.ts -o client/public/engine.wasm -t client/public/engine.wat --debug --runtime stub --exportRuntime --bindings esm",
		"triage:art": "tsx scripts/triagePendingArt.ts"
	},
	"dependencies": {
		"@jridgewell/trace-mapping": "^0.3.25",
		"@neondatabase/serverless": "^0.10.4",
		"@noble/curves": "^2.0.1",
		"@noble/hashes": "^2.0.1",
		"@octokit/rest": "^22.0.0",
		"@tanstack/react-virtual": "^3.13.19",
		"@types/howler": "^2.2.12",
		"@types/jest": "^29.5.14",
		"@types/multer": "^1.4.12",
		"@types/uuid": "^10.0.0",
		"@typescript-eslint/eslint-plugin": "^8.31.0",
		"@typescript-eslint/parser": "^8.31.0",
		"axios": "^1.9.0",
		"chalk": "^5.4.1",
		"cheerio": "^1.0.0",
		"clsx": "^2.1.1",
		"date-fns": "^3.6.0",
		"dotenv": "^16.4.7",
		"drizzle-orm": "^0.39.1",
		"drizzle-zod": "^0.7.0",
		"eslint": "^9.25.1",
		"eslint-plugin-react": "^7.37.5",
		"express": "^4.21.2",
		"express-rate-limit": "^8.2.1",
		"fflate": "^0.8.2",
		"framer-motion": "^11.13.1",
		"glob": "^11.0.1",
		"gsap": "^3.14.2",
		"helmet": "^8.1.0",
		"hive-tx": "^7.0.1",
		"howler": "^2.2.4",
		"jest": "^29.7.0",
		"lucide-react": "^0.453.0",
		"multer": "^1.4.5-lts.2",
		"pg": "^8.15.6",
		"pixi-filters": "^6.1.5",
		"pixi.js": "^8.8.1",
		"react": "^18.3.1",
		"react-confetti": "^6.4.0",
		"react-dom": "^18.3.1",
		"react-haiku": "^2.2.0",
		"react-helmet-async": "^2.0.5",
		"react-icons": "^5.4.0",
		"react-intersection-observer": "^10.0.3",
		"react-markdown": "^10.1.0",
		"react-resizable-panels": "^2.1.4",
		"react-router-dom": "^6.30.0",
		"react-syntax-highlighter": "^15.5.0",
		"simplex-noise": "^4.0.3",
		"sonner": "^1.7.1",
		"tailwind-merge": "^2.5.4",
		"ts-jest": "^29.3.2",
		"ts-morph": "^25.0.1",
		"ts-node": "^10.9.2",
		"uuid": "^11.1.0",
		"ws": "^8.18.1",
		"zod": "^3.23.8",
		"zod-validation-error": "^3.4.0",
		"zustand": "^5.0.3"
	},
	"devDependencies": {
		"@assemblyscript/loader": "^0.28.9",
		"@tailwindcss/vite": "^4.2.4",
		"@types/express": "4.17.21",
		"@types/node": "20.16.11",
		"@types/react": "^18.3.11",
		"@types/react-dom": "^18.3.1",
		"@types/ws": "^8.5.13",
		"@vitejs/plugin-react": "^4.3.2",
		"archiver": "^7.0.1",
		"assemblyscript": "^0.28.9",
		"autoprefixer": "^10.4.20",
		"drizzle-kit": "^0.30.4",
		"esbuild": "^0.25.0",
		"eslint-plugin-react-hooks": "^5.1.0",
		"fake-indexeddb": "^6.2.5",
		"postcss": "^8.4.47",
		"rollup-plugin-visualizer": "^7.0.1",
		"sharp": "^0.34.5",
		"stylelint": "^17.6.0",
		"stylelint-config-standard": "^40.0.0",
		"tailwindcss": "^4.2.4",
		"tsx": "^4.19.1",
		"typescript": "^5.6.3",
		"vite": "^5.4.14",
		"vitest": "^4.0.18"
	},
	"optionalDependencies": {
		"bufferutil": "^4.0.8"
	}
}
